# codestep 전용 Cloudflare 터널 연결기 (Earth의 cloudflared.service와 별개)
# 토큰: /etc/codestep/tunnel.token (codestep 소유, 0600)
# 설치: sudo install -m 644 deploy/codestep-tunnel.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now codestep-tunnel
[Unit]
Description=codestep Cloudflare Tunnel
After=network-online.target codestep-web.service
Wants=network-online.target

[Service]
Type=simple
User=codestep
Group=codestep
# 메트릭 포트를 고정해 Earth 터널(20241)과 겹치지 않게 한다
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:20251 run --token-file /etc/codestep/tunnel.token
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=192M

[Install]
WantedBy=multi-user.target
